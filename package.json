{
  "name": "vmu-workbench",
  "version": "0.1.0",
  "description": "Dreamcast VMU editor: save editing/modding, LC86K minigame emulator, MCP analysis tools",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "serve": "node serve.js",
    "build:rom": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_rom.ps1",
    "verify:emu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/emu_verify.ps1",
    "emu:manual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/emu_verify.ps1 -Manual",
    "build:transfer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vmu_transfer.ps1",
    "verify:transfer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vmu_transfer.ps1 -Test"
  }
}
